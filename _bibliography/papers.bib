@article{stutzman2025afghanistan,
  abbr={Sci. Adv.},
  bibtex_show={true},
  title={Epilogue to the war: {Afghanistan} reports the lowest well-being in recorded history},
  author={Stutzman, Levi D. and Lun, Polin and Yang, Mei and Chan, Kevin and Cheung, Felix},
  journal={Science Advances},
  volume={11},
  number={22},
  year={2025},
  doi={10.1126/sciadv.ads4156},
  html={https://www.science.org/doi/10.1126/sciadv.ads4156},
  abstract={Using nationally representative survey data collected after the 2021 US withdrawal from Afghanistan, we document that Afghans report the lowest life satisfaction ever recorded in global well-being data—lower than any country measured since systematic collection began. These findings provide quantitative evidence of the severe human cost of prolonged conflict and political instability, and call for targeted international attention to post-conflict recovery.},
  selected={true}
}

@article{chen2025hysteresis,
  abbr={JEP:HPP},
  bibtex_show={true},
  title={A large positive hysteresis effect for scene categories},
  author={Chen, He and Yang, Mei and Son, Gwidon and Mack, Michael L. and Walther, Dirk B.},
  journal={Journal of Experimental Psychology: Human Perception and Performance},
  year={2025},
  doi={10.1037/xhp0001416},
  html={https://psycnet.apa.org/doiLanding?doi=10.1037%2Fxhp0001416},
  abstract={When does the visual system commit to perceiving one scene category over another? We demonstrate a large positive hysteresis effect: the scene category you perceived most recently biases your interpretation of a subsequent ambiguous scene, and this history-dependence is far stronger than prior estimates suggested. The results reveal that visual scene categorization is not a stateless, bottom-up process—it is deeply shaped by recent perceptual history.},
  selected={true}
}

@article{yang2025bridges,
  abbr={PLOS ONE},
  bibtex_show={true},
  title={Empirical aesthetics of bridges},
  author={Yang, Mei and Damiano, Claudia and Gauvreau, Paul and Walther, Dirk B.},
  journal={PLOS ONE},
  year={2025},
  doi={10.1371/journal.pone.0338493},
  html={https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0338493},
  abstract={Bridges serve dual purposes as functional infrastructure and aesthetic objects. We had 254 online participants rate 491 bridge images on aesthetic pleasure, visual interest, complexity, and perceived safety, while civil engineers annotated each bridge's structural type, material, age, and aesthetic investment. Factor analysis revealed two principal dimensions: an "aesthetics" dimension linking pleasure, interest, and complexity to bridge type, and a "perceived safety" dimension linking safety to materials and age. Contour analysis further showed that cable-stayed and suspension bridges—with shorter, more angular contours—receive higher aesthetic ratings than slab bridges. This study offers systematic empirical data to ground bridge design decisions in public aesthetic experience.},
  note={Media coverage: <a href="https://www.psych.utoronto.ca/news/empirical-aesthetics-of-bridges" target="_blank">UofT Psychology</a>},
  selected={true}
}
